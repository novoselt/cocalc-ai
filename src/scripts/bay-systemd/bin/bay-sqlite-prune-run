#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "${SCRIPT_DIR}/lib.sh"

if [[ "${COCALC_BAY_SQLITE_BACKUP_ENABLED:-0}" != "1" ]]; then
  bay_log "changed-only SQLite backup is disabled"
  exit 0
fi

assert_backup_storage_ready

: "${COCALC_BAY_SQLITE_RUSTIC_BIN:=/usr/local/bin/rustic}"
: "${COCALC_BAY_SQLITE_RUSTIC_PROFILE:=${COCALC_BAY_BACKUP_DIR}/sqlite-mirror/rustic.toml}"
: "${COCALC_BAY_SQLITE_BACKUP_LOCK:=${COCALC_BAY_RUN_DIR}/sqlite-backup.lock}"

if [[ ! -x "$COCALC_BAY_SQLITE_RUSTIC_BIN" ]]; then
  bay_log "Rustic binary is not executable: ${COCALC_BAY_SQLITE_RUSTIC_BIN}"
  exit 1
fi
if [[ ! -r "$COCALC_BAY_SQLITE_RUSTIC_PROFILE" ]]; then
  bay_log "Rustic profile does not exist; run a SQLite backup first"
  exit 1
fi
ensure_dirs
exec 9> "$COCALC_BAY_SQLITE_BACKUP_LOCK"
if ! flock -n 9; then
  bay_log "another SQLite backup or prune operation is active"
  exit 0
fi
profile="${COCALC_BAY_SQLITE_RUSTIC_PROFILE%.toml}"
exec "$COCALC_BAY_SQLITE_RUSTIC_BIN" -P "$profile" prune \
  --max-repack 2% \
  --max-unused 10%
