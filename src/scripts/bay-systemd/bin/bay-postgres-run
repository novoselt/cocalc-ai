#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "${SCRIPT_DIR}/lib.sh"

ensure_dirs
if [[ "${COCALC_BAY_PGBACKREST_ENABLED:-0}" == "1" ]]; then
  "${SCRIPT_DIR}/bay-pgbackrest-configure"
  archive_command="${SCRIPT_DIR}/bay-pgbackrest-archive-push %p"
  printf -v archive_command_quoted '%q' "$archive_command"
  COCALC_BAY_POSTGRES_CMD+=" -c archive_mode=on -c archive_timeout=60s -c archive_command=${archive_command_quoted}"
fi
run_env_cmd COCALC_BAY_POSTGRES_CMD
