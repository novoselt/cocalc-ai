# Copy to /etc/cocalc/bay-secrets.env.
# This file is intentionally an example only. Keep the real file root-owned and
# readable only by the service user when needed.

DATABASE_URL=postgres://cocalc:replace-me@127.0.0.1:5432/cocalc_bay
COCALC_SESSION_SECRET=replace-me
COCALC_COOKIE_SECRET=replace-me
COCALC_CONAT_SHARED_SECRET=replace-me
COCALC_CLUSTER_SHARED_SECRET=replace-me
COCALC_REQUIRE_SITE_MASTER_KEY=1

# Required only when COCALC_BAY_PGBACKREST_ENABLED=1. Use a dedicated R2 API
# token/key pair scoped to the bay-backup bucket. Keep the cipher pass in the
# independently backed-up site secret set; repository data is not recoverable
# without it.
COCALC_BAY_PGBACKREST_S3_BUCKET=replace-me
COCALC_BAY_PGBACKREST_S3_ENDPOINT=replace-me.r2.cloudflarestorage.com
COCALC_BAY_PGBACKREST_S3_ACCESS_KEY=replace-me
COCALC_BAY_PGBACKREST_S3_SECRET_KEY=replace-me
COCALC_BAY_PGBACKREST_CIPHER_PASS=replace-me

# Independent repository password for the changed-only SQLite Rustic repo.
COCALC_BAY_SQLITE_RUSTIC_PASSWORD=replace-me
