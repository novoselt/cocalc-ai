{
  "name": "@cocalc/app-document-build",
  "version": "0.0.1",
  "description": "Headless document build pipelines for CoCalc",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm exec tsc --build --force",
    "test": "pnpm exec jest",
    "clean": "rm -rf dist node_modules tsconfig.tsbuildinfo",
    "depcheck": "pnpm -w exec depcheck \"$PWD\" --ignores=@types/jest"
  },
  "dependencies": {
    "@cocalc/util": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "ts-jest": "29.4.9",
    "typescript": "^6.0.3"
  },
  "license": "SEE LICENSE.md"
}
