{
  "id": "cocalc/jupyter-python",
  "version": 1,
  "description": "Install CoCalc's minimal Python/Jupyter environment into /opt/cocalc-jupyter.",
  "inputs": {
    "prefix": { "type": "string", "default": "/opt/cocalc-jupyter" },
    "python": { "type": "string", "default": "/usr/bin/python3" },
    "kernel_name": { "type": "string", "default": "python3" },
    "system_site_packages": { "type": "boolean", "default": false },
    "packages": {
      "type": "string[]",
      "default": [
        "ipykernel",
        "ipywidgets",
        "jupyterlab",
        "matplotlib",
        "notebook",
        "numpy",
        "pandas",
        "scipy",
        "scikit-learn",
        "sympy",
        "uv",
        "jupyter-console"
      ]
    },
    "install_bash_kernel": { "type": "boolean", "default": true },
    "owner_uid": { "type": "string", "default": "2001" },
    "owner_gid": { "type": "string", "default": "2001" }
  },
  "run": { "shell": "bash", "script": "install.sh" },
  "verify": { "shell": "bash", "script": "verify.sh" },
  "contributes": {
    "metadata": {
      "family": "python",
      "tags": ["python", "jupyter", "bash-kernel"]
    },
    "content": {
      "version": 1,
      "title": "CoCalc Python and Jupyter",
      "subtitle": "Python, JupyterLab, scientific Python packages, uv, and a bash notebook kernel.",
      "highlights": [
        "Python 3",
        "JupyterLab",
        "bash kernel",
        "scientific Python"
      ],
      "actions": [
        {
          "kind": "project-app",
          "label": "Launch JupyterLab",
          "description": "Start JupyterLab on this image's Jupyter kernels.",
          "app_spec": {
            "version": 1,
            "id": "jupyterlab",
            "title": "JupyterLab",
            "kind": "service",
            "command": {
              "exec": "bash",
              "args": [
                "-lc",
                "base_url=\"${APP_BASE_URL/\\/proxy\\//\\/port\\/}\"; jupyter lab --allow-root --port-retries=0 --no-browser --NotebookApp.token= --NotebookApp.password= --ServerApp.disable_check_xsrf=True --NotebookApp.allow_remote_access=True --NotebookApp.mathjax_url=/cdn/mathjax/MathJax.js --NotebookApp.base_url=\"${base_url}\" --ServerApp.base_url=\"${base_url}\" --ip=${HOST:-127.0.0.1} --port=${PORT}"
              ]
            },
            "lifecycle": {
              "mode": "managed"
            },
            "network": {
              "listen_host": "127.0.0.1",
              "port": 6012,
              "protocol": "http"
            },
            "proxy": {
              "base_path": "/apps/jupyterlab",
              "strip_prefix": true,
              "websocket": true,
              "open_mode": "port",
              "health_path": "/lab",
              "readiness_timeout_s": 45
            },
            "wake": {
              "enabled": true,
              "keep_warm_s": 1800,
              "startup_timeout_s": 120
            }
          }
        }
      ]
    }
  }
}
