{
  "id": "cocalc/octave",
  "version": 1,
  "description": "Run a script from the octave-installer repository: build GNU Octave from source, install Octave packages, register a Jupyter kernel, verify the tree, or run the test suite.",
  "timeout": 14400,
  "inputs": {
    "repo_url": {
      "type": "string",
      "default": "https://github.com/sagemathinc/octave-installer.git"
    },
    "repo_ref": { "type": "string", "default": "main" },
    "script": { "type": "string", "default": "install.sh" },

    "version": { "type": "string", "default": "11.3.0" },
    "prefix": { "type": "string", "default": "/usr/local" },
    "mirror": { "type": "string", "default": "https://ftp.gnu.org/gnu/octave" },
    "sha256": { "type": "string", "default": "" },
    "jobs": { "type": "string", "default": "auto" },
    "build_dir": { "type": "string", "default": "/var/tmp" },
    "optimize": { "type": "string", "default": "-O2" },
    "enable_gui": { "type": "boolean", "default": false },
    "enable_java": { "type": "boolean", "default": false },
    "strip_binaries": { "type": "boolean", "default": true },
    "remove_manuals": { "type": "boolean", "default": true },
    "keep_man_pages": { "type": "boolean", "default": true },
    "graphics_toolkit": { "type": "string", "default": "gnuplot" },
    "configure_extra": { "type": "string", "default": "" },
    "purge_build_deps": { "type": "boolean", "default": false },
    "min_free_kb": { "type": "string", "default": "12000000" },

    "octave_packages": {
      "type": "string[]",
      "default": [
        "struct",
        "io",
        "statistics",
        "control",
        "signal",
        "image",
        "optim",
        "symbolic"
      ]
    },
    "autoload": { "type": "boolean", "default": false },
    "install_attempts": { "type": "string", "default": "3" },

    "jupyter_prefix": { "type": "string", "default": "/opt/cocalc-jupyter" },
    "kernel_name": { "type": "string", "default": "octave" },
    "kernel_display_name": { "type": "string", "default": "Octave" },
    "octave_kernel_version": { "type": "string", "default": "" },
    "python_kernel_name": { "type": "string", "default": "python3" },
    "owner_uid": { "type": "string", "default": "2001" },
    "owner_gid": { "type": "string", "default": "2001" },

    "test_packages": { "type": "boolean", "default": true },
    "test_kernels": { "type": "boolean", "default": true },
    "test_kernel_plots": { "type": "boolean", "default": true }
  },
  "run": { "shell": "bash", "script": "install.sh" },
  "contributes": {
    "metadata": {
      "family": "octave",
      "tags": ["octave", "math", "numerical", "jupyter"]
    },
    "theme": {
      "icon": "octave",
      "color": "#ffffff",
      "accent_color": "#0790c0",
      "image_blob": "cae9c762-e284-4d47-aa30-65d7598ac88c"
    },
    "content": {
      "version": 1,
      "title": "GNU Octave",
      "subtitle": "GNU Octave 11.3, built from source",
      "description": "A current GNU Octave built from source, with the common Octave packages — statistics, control, signal, image, optim and symbolic — and Jupyter kernels for Octave and Python. JupyterLab is included and can be started from the launcher.",
      "highlights": [
        "octave",
        "jupyter",
        "symbolic",
        "statistics",
        "signal",
        "control",
        "image",
        "optim",
        "numpy",
        "scipy",
        "matplotlib"
      ],
      "actions": [
        {
          "kind": "project-app",
          "label": "Launch JupyterLab",
          "description": "Open JupyterLab on this image's Octave, Python and bash kernels.",
          "app_spec": {
            "version": 1,
            "id": "jupyterlab",
            "title": "JupyterLab",
            "kind": "service",
            "command": {
              "exec": "bash",
              "args": [
                "-lc",
                "base_url=\"${APP_BASE_URL/\\/proxy\\//\\/port\\/}\"; jupyter lab --allow-root --port-retries=0 --no-browser --NotebookApp.token= --NotebookApp.password= --ServerApp.disable_check_xsrf=True --NotebookApp.allow_remote_access=True --NotebookApp.mathjax_url=/cdn/mathjax/MathJax.js --NotebookApp.base_url=\"${base_url}\" --ServerApp.base_url=\"${base_url}\" --ip=${HOST:-127.0.0.1} --port=${PORT}"
              ]
            },
            "lifecycle": {
              "mode": "managed"
            },
            "network": {
              "listen_host": "127.0.0.1",
              "port": 6012,
              "protocol": "http"
            },
            "proxy": {
              "base_path": "/apps/jupyterlab",
              "strip_prefix": true,
              "websocket": true,
              "open_mode": "port",
              "health_path": "/lab",
              "readiness_timeout_s": 45
            },
            "wake": {
              "enabled": true,
              "keep_warm_s": 1800,
              "startup_timeout_s": 120
            }
          }
        }
      ]
    }
  }
}
